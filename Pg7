#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    long long diff = *(int*)a - *(int*)b;
    return (diff > 0) - (diff < 0);
}

int** fourSum(int* nums, int numsSize, int target, int* returnSize, int** returnColumnSizes) {
    // Initialise return parameters to handle early exit conditions
    *returnSize = 0;
    if (numsSize < 4) {
        *returnColumnSizes = NULL;
        return NULL;
    }

    // 1. Sort the input array
    qsort(nums, numsSize, sizeof(int), compare);

    // Dynamic allocation strategy for results
    int capacity = 16;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));

    // 2. Nested loops with two-pointer strategy
    for (int i = 0; i < numsSize - 3; i++) {
        // Skip duplicate values for the first element
        if (i > 0 && nums[i] == nums[i - 1]) continue;

        // Optimization: Early termination checks using long long to prevent overflow
        if ((long long)nums[i] + nums[i + 1] + nums[i + 2] + nums[i + 3] > target) break;
        if ((long long)nums[i] + nums[numsSize - 3] + nums[numsSize - 2] + nums[numsSize - 1] < target) continue;

        for (int j = i + 1; j < numsSize - 2; j++) {
            // Skip duplicate values for the second element
            if (j > j + 1 && nums[j] == nums[j - 1]) continue; // Wait, watch out for this line: j > i + 1 is correct
            if (j > i + 1 && nums[j] == nums[j - 1]) continue;

            // Optimization: Early termination checks for the second loop
            if ((long long)nums[i] + nums[j] + nums[j + 1] + nums[j + 2] > target) break;
            if ((long long)nums[i] + nums[j] + nums[numsSize - 2] + nums[numsSize - 1] < target) continue;

            int left = j + 1;
            int right = numsSize - 1;

            while (left < right) {
                long long currentSum = (long long)nums[i] + nums[j] + nums[left] + nums[right];

                if (currentSum == target) {
                    // Resize results buffer if capacity is reached
                    if (*returnSize >= capacity) {
                        capacity *= 2;
                        result = (int**)realloc(result, capacity * sizeof(int*));
                        *returnColumnSizes = (int*)realloc(*returnColumnSizes, capacity * sizeof(int));
                    }

                    // Allocate and store the valid quadruplet
                    result[*returnSize] = (int*)malloc(4 * sizeof(int));
                    result[*returnSize][0] = nums[i];
                    result[*returnSize][1] = nums[j];
                    result[*returnSize][2] = nums[left];
                    result[*returnSize][3] = nums[right];
                    (*returnColumnSizes)[*returnSize] = 4;
                    (*returnSize)++;

                    // Move pointers past duplicates
                    while (left < right && nums[left] == nums[left + 1]) left++;
                    while (left < right && nums[right] == nums[right - 1]) right--;

                    left++;
                    right--;
                } else if (currentSum < target) {
                    left++;
                } else {
                    right--;
                }
            }
        }
    }

    return result;
}
