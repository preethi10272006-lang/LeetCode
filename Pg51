#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

bool isMatch(char* s, char* p) {
    int sLen = strlen(s);
    int pLen = strlen(p);

    // Create a 2D DP table of size (sLen + 1) x (pLen + 1)
    // dp[i][j] represents if s[0...i-1] matches p[0...j-1]
    bool** dp = (bool**)malloc((sLen + 1) * sizeof(bool*));
    for (int i = 0; i <= sLen; i++) {
        dp[i] = (bool*)calloc((pLen + 1), sizeof(bool));
    }

    // Base Case: Empty string matches empty pattern
    dp[0][0] = true;

    // Deal with patterns like a*, a*b*, or a*b*c* matching an empty string s
    for (int j = 2; j <= pLen; j++) {
        if (p[j - 1] == '*') {
            dp[0][j] = dp[0][j - 2];
        }
    }

    // Fill the DP table
    for (int i = 1; i <= sLen; i++) {
        for (int j = 1; j <= pLen; j++) {
            // Case 1: Current characters match, or pattern has '.'
            if (p[j - 1] == s[i - 1] || p[j - 1] == '.') {
                dp[i][j] = dp[i - 1][j - 1];
            } 
            // Case 2: Pattern has '*'
            else if (p[j - 1] == '*') {
                // Subcase A: Count the '*' as 0 repetitions of the preceding element
                dp[i][j] = dp[i][j - 2];

                // Subcase B: If the preceding element matches the current string char,
                // we can choose to consume the current string character.
                if (p[j - 2] == s[i - 1] || p[j - 2] == '.') {
                    dp[i][j] = dp[i][j] || dp[i - 1][j];
                }
            }
        }
    }

    bool result = dp[sLen][pLen];

    // Clean up allocated DP table memory
    for (int i = 0; i <= sLen; i++) {
        free(dp[i]);
    }
    free(dp);

    return result;
}
