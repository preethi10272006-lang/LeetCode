#include <stdbool.h>

bool isPalindrome(int x) {
    // Edge Cases:
    // 1. Negative numbers are not palindromes (e.g., -121 reversed becomes 121-)
    // 2. If the last digit is 0, the first digit must also be 0 (only '0' itself satisfies this)
    if (x < 0 || (x % 10 == 0 && x != 0)) {
        return false;
    }

    int reversedHalf = 0;
    
    // Reverse the second half of the number
    while (x > reversedHalf) {
        reversedHalf = (reversedHalf * 10) + (x % 10);
        x /= 10;
    }

    // For even-length numbers (e.g., 1221): x will be 12, reversedHalf will be 12 -> 12 == 12
    // For odd-length numbers (e.g., 12321): x will be 12, reversedHalf will be 123 -> x == reversedHalf / 10
    return x == reversedHalf || x == reversedHalf / 10;
}
