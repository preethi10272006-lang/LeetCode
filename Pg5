#include <stdlib.h>
#include <string.h>

#define HASH_SIZE 10007

// Hash map node to store element frequencies
typedef struct HashNode {
    int key;
    int value;
    struct HashNode* next;
} HashNode;

// Hash map structure
typedef struct {
    HashNode* buckets[HASH_SIZE];
} HashMap;

// Dynamic array to act as a stack for a specific frequency
typedef struct {
    int* data;
    int top;
    int capacity;
} Stack;

typedef struct {
    HashMap* freq_map;       // Maps element -> frequency
    Stack** group_map;       // Maps frequency -> stack of elements
    int group_capacity;      // Capacity of the group_map array
    int max_freq;            // Tracks the current maximum frequency
} FreqStack;

// --- Helper Functions for HashMap ---
HashMap* createMap() {
    HashMap* map = (HashMap*)calloc(1, sizeof(HashMap));
    return map;
}

int getHash(int key) {
    int hash = key % HASH_SIZE;
    return hash < 0 ? hash + HASH_SIZE : hash;
}

int mapGet(HashMap* map, int key) {
    int bucket = getHash(key);
    HashNode* curr = map->buckets[bucket];
    while (curr) {
        if (curr->key == key) return curr->value;
        curr = curr->next;
    }
    return 0;
}

void mapPut(HashMap* map, int key, int value) {
    int bucket = getHash(key);
    HashNode* curr = map->buckets[bucket];
    while (curr) {
        if (curr->key == key) {
            curr->value = value;
            return;
        }
        curr = curr->next;
    }
    HashNode* newNode = (HashNode*)malloc(sizeof(HashNode));
    newNode->key = key;
    newNode->value = value;
    newNode->next = map->buckets[bucket];
    map->buckets[bucket] = newNode;
}

void freeMap(HashMap* map) {
    for (int i = 0; i < HASH_SIZE; i++) {
        HashNode* curr = map->buckets[i];
        while (curr) {
            HashNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(map);
}

// --- Helper Functions for Stack ---
Stack* createStack() {
    Stack* stack = (Stack*)malloc(sizeof(Stack));
    stack->capacity = 16;
    stack->top = -1;
    stack->data = (int*)malloc(stack->capacity * sizeof(int));
    return stack;
}

void stackPush(Stack* stack, int val) {
    if (stack->top + 1 >= stack->capacity) {
        stack->capacity *= 2;
        stack->data = (int*)realloc(stack->data, stack->capacity * sizeof(int));
    }
    stack->data[++(stack->top)] = val;
}

int stackPop(Stack* stack) {
    return stack->data[(stack->top)--];
}

void freeStack(Stack* stack) {
    if (stack) {
        free(stack->data);
        free(stack);
    }
}

// --- FreqStack Core API ---

FreqStack* freqStackCreate() {
    FreqStack* obj = (FreqStack*)malloc(sizeof(FreqStack));
    obj->freq_map = createMap();
    obj->group_capacity = 16;
    obj->group_map = (Stack**)calloc(obj->group_capacity, sizeof(Stack*));
    obj->max_freq = 0;
    return obj;
}

void freqStackPush(FreqStack* obj, int val) {
    // 1. Update frequency of the value
    int freq = mapGet(obj->freq_map, val) + 1;
    mapPut(obj->freq_map, val, freq);
    
    // 2. Track maximum frequency
    if (freq > obj->max_freq) {
        obj->max_freq = freq;
    }
    
    // 3. Resize group_map if needed to accommodate new frequencies
    if (freq >= obj->group_capacity) {
        int old_capacity = obj->group_capacity;
        obj->group_capacity *= 2;
        obj->group_map = (Stack**)realloc(obj->group_map, obj->group_capacity * sizeof(Stack*));
        memset(obj->group_map + old_capacity, 0, (obj->group_capacity - old_capacity) * sizeof(Stack*));
    }
    
    // 4. Push value to the stack corresponding to its current frequency
    if (!obj->group_map[freq]) {
        obj->group_map[freq] = createStack();
    }
    stackPush(obj->group_map[freq], val);
}

int freqStackPop(FreqStack* obj) {
    // 1. Pop the top element from the max frequency stack
    int val = stackPop(obj->group_map[obj->max_freq]);
    
    // 2. Decrement frequency in the frequency map
    int freq = mapGet(obj->freq_map, val);
    mapPut(obj->freq_map, val, freq - 1);
    
    // 3. If the highest frequency stack becomes empty, decrement max_freq
    if (obj->group_map[obj->max_freq]->top == -1) {
        obj->max_freq--;
    }
    
    return val;
}

void freqStackFree(FreqStack* obj) {
    if (!obj) return;
    freeMap(obj->freq_map);
    for (int i = 0; i < obj->group_capacity; i++) {
        if (obj->group_map[i]) {
            freeStack(obj->group_map[i]);
        }
    }
    free(obj->group_map);
    free(obj);
}
