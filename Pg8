#include <stdlib.h>

// Define the Trie node structure
typedef struct TrieNode {
    struct TrieNode* children[2];
} TrieNode;

// Helper function to create a new Trie node
TrieNode* createNode() {
    TrieNode* node = (TrieNode*)malloc(sizeof(TrieNode));
    node->children[0] = NULL;
    node->children[1] = NULL;
    return node;
}

// Helper function to insert a number into the Trie (bit by bit)
void insert(TrieNode* root, int num) {
    TrieNode* curr = root;
    for (int i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        if (!curr->children[bit]) {
            curr->children[bit] = createNode();
        }
        curr = curr->children[bit];
    }
}

// Helper function to find the maximum XOR for a given number using the Trie
int getMaxXOR(TrieNode* root, int num) {
    TrieNode* curr = root;
    int max_xor = 0;
    for (int i = 30; i >= 0; i--) {
        int bit = (num >> i) & 1;
        // To maximize XOR, we want the opposite bit (1 if bit is 0, 0 if bit is 1)
        int toggle_bit = 1 - bit; 
        
        if (curr->children[toggle_bit]) {
            max_xor |= (1 << i); // Set the i-th bit of the result to 1
            curr = curr->children[toggle_bit];
        } else {
            curr = curr->children[bit]; // Have to take the same bit, resulting in 0 XOR at this position
        }
    }
    return max_xor;
}

// Helper function to free the allocated memory for the Trie
void freeTrie(TrieNode* root) {
    if (!root) return;
    freeTrie(root->children[0]);
    freeTrie(root->children[1]);
    free(root);
}

int findMaximumXOR(int* nums, int numsSize) {
    if (numsSize < 2) return 0;

    TrieNode* root = createNode();
    int maxXOR = 0;

    // Insert the first number into the Trie
    insert(root, nums[0]);

    // For each subsequent number, find its max XOR with existing numbers, then insert it
    for (int i = 1; i < numsSize; i++) {
        int currentXOR = getMaxXOR(root, nums[i]);
        if (currentXOR > maxXOR) {
            maxXOR = currentXOR;
        }
        insert(root, nums[i]);
    }

    // Clean up memory
    freeTrie(root);

    return maxXOR;
}
