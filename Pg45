int majorityElement(int* nums, int numsSize) {
    int count = 0;
    int candidate = 0;
    
    // Boyer-Moore Voting Algorithm
    for (int i = 0; i < numsSize; i++) {
        // When count becomes 0, we choose a new candidate
        if (count == 0) {
            candidate = nums[i];
        }
        
        // Update count based on the current element
        if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }
    
    return candidate;
}
