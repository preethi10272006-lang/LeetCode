struct ListNode* reverseKGroup(struct ListNode* head, int k) {
    if (!head || k == 1) return head;
    
    // 1. Create a dummy node to handle head changes cleanly
    struct ListNode dummy;
    dummy.next = head;
    
    struct ListNode* prevGroupEnd = &dummy;
    struct ListNode* curr = head;
    
    while (curr) {
        // 2. Check if there are at least k nodes left in the group
        struct ListNode* groupEnd = prevGroupEnd;
        for (int i = 0; i < k; i++) {
            groupEnd = groupEnd->next;
            if (!groupEnd) {
                // Less than k nodes left, keep them as is and exit
                return dummy.next;
            }
        }
        
        // 3. Track the node right after this group
        struct ListNode* nextGroupStart = groupEnd->next;
        
        // 4. Reverse the k nodes locally
        struct ListNode* prev = nextGroupStart; // Links the tail to the next group
        struct ListNode* localCurr = curr;
        
        while (localCurr != nextGroupStart) {
            struct ListNode* nextTmp = localCurr->next;
            localCurr->next = prev;
            prev = localCurr;
            localCurr = nextTmp;
        }
        
        // 5. Connect the previous group's end to the new head of this reversed group
        prevGroupEnd->next = groupEnd;
        
        // 6. Move pointers forward for the next iteration
        prevGroupEnd = curr; // 'curr' has now become the tail of the reversed group
        curr = nextGroupStart;
    }
    
    // Return the actual head pointer
    return dummy.next;
}
