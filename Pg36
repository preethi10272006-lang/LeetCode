#include <stdlib.h>
#include <string.h>

char* intToRoman(int num) {
    // Array of Roman numeral values from largest to smallest
    int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    
    // Corresponding Roman numeral symbols
    char* symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    // Allocate memory for the output string
    // Maximum possible length is 15 characters (e.g., 3888 -> "MMMDCCCLXXXVIII") + 1 for '\0'
    char* roman = (char*)malloc(16 * sizeof(char));
    roman[0] = '\0'; // Initialize as an empty string
    
    // Loop through the values array
    for (int i = 0; i < 13 && num > 0; i++) {
        // While the current value can be subtracted from num
        while (num >= values[i]) {
            strcat(roman, symbols[i]); // Append the Roman symbol
            num -= values[i];          // Subtract its value
        }
    }
    
    return roman;
}
