#include <stdbool.h>
#include <stdlib.h>

// Standard Queue Implementation
typedef struct QueueNode {
    int val;
    struct QueueNode* next;
} QueueNode;

typedef struct {
    QueueNode* front;
    QueueNode* rear;
} Queue;

Queue* createQueue() {
    Queue* q = (Queue*)malloc(sizeof(Queue));
    q->front = q->rear = NULL;
    return q;
}

void enqueue(Queue* q, int val) {
    QueueNode* newNode = (QueueNode*)malloc(sizeof(QueueNode));
    newNode->val = val;
    newNode->next = NULL;
    if (q->rear == NULL) {
        q->front = q->rear = newNode;
        return;
    }
    q->rear->next = newNode;
    q->rear = newNode;
}

int dequeue(Queue* q) {
    if (q->front == NULL) return -1;
    QueueNode* temp = q->front;
    int val = temp->val;
    q->front = q->front->next;
    if (q->front == NULL) {
        q->rear = NULL;
    }
    free(temp);
    return val;
}

int peekQueue(Queue* q) {
    return (q->front != NULL) ? q->front->val : -1;
}

bool isQueueEmpty(Queue* q) {
    return q->front == NULL;
}

void freeQueue(Queue* q) {
    while (!isQueueEmpty(q)) {
        dequeue(q);
    }
    free(q);
}

// --- LeetCode MyStack Interface ---

typedef struct {
    Queue* q;
    int size;
} MyStack;

// 1. ADD THIS DECLARATION HERE (Forward Declaration)
bool myStackEmpty(MyStack* obj);

MyStack* myStackCreate() {
    MyStack* stack = (MyStack*)malloc(sizeof(MyStack));
    stack->q = createQueue();
    stack->size = 0;
    return stack;
}

void myStackPush(MyStack* obj, int x) {
    enqueue(obj->q, x);
    obj->size++;
    for (int i = 0; i < obj->size - 1; i++) {
        enqueue(obj->q, dequeue(obj->q));
    }
}

// Now this will compile perfectly because of the declaration above!
int myStackPop(MyStack* obj) {
    if (myStackEmpty(obj)) return -1;
    obj->size--;
    return dequeue(obj->q);
}

int myStackTop(MyStack* obj) {
    if (myStackEmpty(obj)) return -1;
    return peekQueue(obj->q);
}

// This remains at the bottom
bool myStackEmpty(MyStack* obj) {
    return isQueueEmpty(obj->q);
}

void myStackFree(MyStack* obj) {
    if (obj) {
        freeQueue(obj->q);
        free(obj);
    }
}
