struct ListNode* rotateRight(struct ListNode* head, int k) {
    if (!head || !head->next || k == 0) return head;

    // Step 1: Calculate length and find the tail node
    int length = 1;
    struct ListNode* tail = head;
    while (tail->next != NULL) {
        tail = tail->next;
        length++;
    }

    // Step 2: Handle edge cases where k >= length
    k = k % length;
    if (k == 0) return head;

    // Step 3: Link tail to head to close the loop
    tail->next = head;

    // Step 4: Find the new tail position
    int stepsToNewTail = length - k;
    struct ListNode* newTail = head;
    for (int i = 1; i < stepsToNewTail; i++) {
        newTail = newTail->next;
    }

    // Step 5: Set up new head and break the loop
    struct ListNode* newHead = newTail->next;
    newTail->next = NULL;

    return newHead;
}
