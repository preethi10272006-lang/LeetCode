#include <string.h>

// Helper function to return the value of a Roman character
int getRomanValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int length = strlen(s);
    
    for (int i = 0; i < length; i++) {
        int currentVal = getRomanValue(s[i]);
        
        // If this is not the last character, look ahead to the next one
        if (i + 1 < length) {
            int nextVal = getRomanValue(s[i + 1]);
            
            // Subtraction rule: if current value is less than next value
            if (currentVal < nextVal) {
                total -= currentVal;
                continue; // Skip the addition step below
            }
        }
        
        // Standard addition rule
        total += currentVal;
    }
    
    return total;
}
