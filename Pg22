#include <stdio.h>

long long maximumSubarraySum(int* nums, int numsSize, int k) {
    long long max_sum = 0;
    long long current_sum = 0;
    
    // Frequency array to keep track of element counts in the current window
    // Size 100001 handles values up to 10^5 safely
    int freq[100001] = {0}; 
    int unique_count = 0;   // Tracks how many unique numbers are in the window
    
    for (int i = 0; i < numsSize; i++) {
        // --- 1. Add the incoming element ---
        current_sum += nums[i];
        if (freq[nums[i]] == 0) {
            unique_count++; // New unique element added to window
        }
        freq[nums[i]]++;
        
        // --- 2. Remove the outgoing element if window size exceeds k ---
        if (i >= k) {
            int outgoing = nums[i - k];
            current_sum -= outgoing;
            freq[outgoing]--;
            if (freq[outgoing] == 0) {
                unique_count--; // Element completely left the window
            }
        }
        
        // --- 3. Check validity when window size is exactly k ---
        if (i >= k - 1) {
            // If all elements in the window are unique, unique_count must equal k
            if (unique_count == k) {
                if (current_sum > max_sum) {
                    max_sum = current_sum;
                }
            }
        }
    }
    
    return max_sum;
}
