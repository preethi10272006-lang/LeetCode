#include <stdlib.h>

int* getSubarrayBeauty(int* nums, int numsSize, int k, int x, int* returnSize) {
    // There will be exactly numsSize - k + 1 subarrays of size k
    *returnSize = numsSize - k + 1;
    int* result = (int*)malloc((*returnSize) * sizeof(int));
    
    // Frequency map for negative numbers only (-50 to -1)
    // Index 0 represents -50, index 49 represents -1
    int freq[50] = {0};
    
    for (int i = 0; i < numsSize; i++) {
        // --- 1. Add the incoming element ---
        if (nums[i] < 0) {
            freq[nums[i] + 50]++; // Shift by +50 to map -50..-1 to 0..49
        }
        
        // --- 2. Remove the outgoing element when window size exceeds k ---
        if (i >= k) {
            int outgoing = nums[i - k];
            if (outgoing < 0) {
                freq[outgoing + 50]--;
            }
        }
        
        // --- 3. Calculate beauty when window size is exactly k ---
        if (i >= k - 1) {
            int count = 0;
            int beauty = 0; // Default to 0 if fewer than x negatives
            
            // Iterate through the negative buckets from smallest (-50) to largest (-1)
            for (int j = 0; j < 50; j++) {
                count += freq[j];
                if (count >= x) {
                    beauty = j - 50; // Convert index back to the negative number
                    break;
                }
            }
            
            result[i - k + 1] = beauty;
        }
    }
    
    return result;
}
