#include <limits.h>

int myAtoi(char* s) {
    int i = 0;
    int sign = 1;
    long result = 0; // Use long to safely detect 32-bit overflow before casting

    // 1. Skip all leading whitespaces
    while (s[i] == ' ' || s[i] == '\t' || s[i] == '\n' || 
           s[i] == '\r' || s[i] == '\v' || s[i] == '\f') {
        i++;
    }

    // 2. Check for optional sign indicator
    if (s[i] == '+' || s[i] == '-') {
        if (s[i] == '-') {
            sign = -1;
        }
        i++;
    }

    // 3. Parse digits and handle overflow
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // Check for overflow before multiplying
        // INT_MAX is 2147483647, INT_MIN is -2147483648
        if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > INT_MAX % 10)) {
            return (sign == 1) ? INT_MAX : INT_MIN;
        }

        result = (result * 10) + digit;
        i++;
    }

    return (int)(result * sign);
}
